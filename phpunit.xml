<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="./vendor/phpunit/phpunit/phpunit.xsd" bootstrap="vendor/autoload.php" colors="true" executionOrder="depends,defects" stopOnFailure="false" failOnWarning="false" failOnRisky="false" beStrictAboutOutputDuringTests="false" processIsolation="false" backupGlobals="false" cacheResult="false">
  <testsuites>
    <testsuite name="Database Safety First">
      <file>tests/Unit/DatabaseSafetyCheckTest.php</file>
    </testsuite>
    <testsuite name="Unit">
      <directory suffix="Test.php">./tests/Unit</directory>
      <exclude>tests/Unit/DatabaseSafetyCheckTest.php</exclude>
    </testsuite>
    <testsuite name="Feature">
      <directory suffix="Test.php">./tests/Feature</directory>
      <exclude>./tests/Feature/Api/BaseApiTest.php</exclude>
    </testsuite>
    <!-- The composer test:api / test:web / ... shortcuts target these directories
         individually; they belong here too so `composer test` and the pre-commit
         hook actually run them. tests/Browser is Dusk and needs a real browser. -->
    <testsuite name="Api">
      <directory suffix="Test.php">./tests/Api</directory>
    </testsuite>
    <testsuite name="Web">
      <directory suffix="Test.php">./tests/Web</directory>
    </testsuite>
    <testsuite name="Cli">
      <directory suffix="Test.php">./tests/Cli</directory>
    </testsuite>
    <testsuite name="Core">
      <directory suffix="Test.php">./tests/Core</directory>
    </testsuite>
    <testsuite name="Import">
      <directory suffix="Test.php">./tests/Import</directory>
    </testsuite>
    <testsuite name="Scripts">
      <directory suffix="Test.php">./tests/Scripts</directory>
    </testsuite>
  </testsuites>
  <groups>
    <exclude>
      <group>slow</group>
      <group>deprecated</group>
    </exclude>
  </groups>
  <php>
    <ini name="memory_limit" value="-1"/>
    <server name="APP_ENV" value="testing"/>
    <server name="APP_KEY" value="base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="/>
    <server name="BCRYPT_ROUNDS" value="4"/>
    <server name="CACHE_STORE" value="array"/>
    <server name="DB_CONNECTION" value="sqlite"/>
    <server name="DB_DATABASE" value=":memory:"/>
    <server name="MAIL_MAILER" value="array"/>
    <server name="QUEUE_CONNECTION" value="sync"/>
    <server name="SESSION_DRIVER" value="array"/>
    <server name="TELESCOPE_ENABLED" value="false"/>
    <!-- Firebase support removed - application now uses MySQL only -->
    <server name="DOCUMENT_STORE_DRIVER" value="sqlite"/>
    <server name="LOG_CHANNEL" value="stderr"/>
    <!-- Disable Vite in tests to avoid manifest requirement -->
    <server name="VITE_ENABLED" value="false"/>
    <!-- Force override of .env file -->
    <server name="DB_HOST" value=""/>
    <server name="DB_PORT" value=""/>
    <server name="DB_USERNAME" value=""/>
    <server name="DB_PASSWORD" value=""/>
  </php>
  <source>
    <include>
      <directory suffix=".php">./app</directory>
    </include>
  </source>
</phpunit>
