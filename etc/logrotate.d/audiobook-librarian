#
# Sample logrotate configuration for Audiobook Librarian
# Copy or symlink this file into /etc/logrotate.d and update {PROJECT_PATH}
# to match the absolute path of your deployment.
#
# Rotates every log file in storage/logs: Laravel's laravel.log (and
# laravel-YYYY-MM-DD.log if LOG_CHANNEL=daily), apache_access.log,
# apache_error.log, and any other *.log file written there in the future.
#

{PROJECT_PATH}/storage/logs/*.log {
    daily
    rotate 14
    missingok
    notifempty
    compress
    delaycompress
    copytruncate
    create 0664 www-data www-data
    sharedscripts
    postrotate
        # Warm up Laravel cache/logging to ensure new file permissions stick
        cd {PROJECT_PATH} && /usr/bin/php artisan schedule:run --once >/dev/null 2>&1 || true
    endscript
}
