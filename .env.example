APP_NAME="AbLibrarian Lite"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Public production URL. Use http://localhost:8080 only for same-machine development.
APP_URL=https://server.example.com
PUBLIC_HOST=server.example.com

# Optional absolute paths. Defaults are portable application-storage locations.
# BOOK_STORAGE_PATH=C:\\Audiobooks (Windows) or /Volumes/Audiobooks (macOS) or /srv/audiobooks (Linux)
# DATABASE_BACKUP_PATH=
# IMPORT_ROOTS=

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=sqlite
DB_DATABASE=/app/storage/database.sqlite

# Optional MySQL
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=librarian_lite
# DB_USERNAME=lite
# DB_PASSWORD=secret

CACHE_DRIVER=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync

MAIL_MAILER=log

LITE_REGISTRATION_OPEN=true
LITE_OTP_ENABLED=false
